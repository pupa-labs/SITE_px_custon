# GEMINI_API_KEY: Required for Gemini AI API calls if needed.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# SUPABASE CONFIGURATION (Public Frontend Keys)
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="your-supabase-anon-key"

# SUPABASE BACKEND CONFIGURATION (Server-Only — Never expose in frontend)
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# MERCADO PAGO CONFIGURATION
# Public key for frontend checkout tokenization
VITE_MP_PUBLIC_KEY="APP_USR-your-mercado-pago-public-key"

# Server-side secrets (Backend / Edge Functions only — Never expose in frontend)
MP_ACCESS_TOKEN="APP_USR-your-mercado-pago-access-token"
MP_CLIENT_ID="your-mercado-pago-client-id"
MP_CLIENT_SECRET="your-mercado-pago-client-secret"
MP_WEBHOOK_SECRET="your-mercado-pago-webhook-secret"
